# EditKaro 2.0 - Video Production & Creative Operations Platform
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage (Cloudflare R2 / AWS S3)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=editkario-media
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.editkaro.in

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/editkario
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
